# Database Credentials (pointing to host or postgres container)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=funds
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# RabbitMQ Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Cron Schedule (Default: At 02:00 on the 1st day of Jan, Apr, Jul, Oct)
FUND_ETL_CRON_SCHEDULE=0 2 1 1,4,7,10 *