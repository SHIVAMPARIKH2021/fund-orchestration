{
  "rabbit_version": "3.13.0",
  "users": [
    {
      "name": "guest",
      "password_hash": "guest",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "etl.events.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "etl.events.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "fund.import.trigger.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "etl.events.dlx",
        "x-dead-letter-routing-key": "fund.import.failed"
      }
    },
    {
      "name": "fund.import.trigger.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "etl.events.exchange",
      "vhost": "/",
      "destination": "fund.import.trigger.queue",
      "destination_type": "queue",
      "routing_key": "fund.etl.#",
      "arguments": {}
    },
    {
      "source": "etl.events.dlx",
      "vhost": "/",
      "destination": "fund.import.trigger.dlq",
      "destination_type": "queue",
      "routing_key": "fund.import.failed",
      "arguments": {}
    }
  ]
}