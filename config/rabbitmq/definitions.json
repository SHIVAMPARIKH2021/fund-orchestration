{
  "rabbit_version": "3.13.0",
  "rabbitmq_version": "3.13.0",
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [],
  "permissions": [],
  "queues": [
    {
      "name": "fund.import.trigger.queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "etl.events.dlx",
        "x-dead-letter-routing-key": "fund.import.failed"
      }
    },
    {
      "name": "fund.import.trigger.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "etl.events.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "etl.events.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "etl.events.exchange",
      "vhost": "/",
      "destination": "fund.import.trigger.queue",
      "destination_type": "queue",
      "routing_key": "fund.import.completed",
      "arguments": {}
    },
    {
      "source": "etl.events.dlx",
      "vhost": "/",
      "destination": "fund.import.trigger.dlq",
      "destination_type": "queue",
      "routing_key": "fund.import.failed",
      "arguments": {}
    }
  ]
}