pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        booleanParam(name: 'RESET_BROKER_DATA', defaultValue: false, description: 'Purge existing RabbitMQ volume to clear queue metadata')
        booleanParam(name: 'FORCE_DOCKER_NO_CACHE', defaultValue: false, description: 'Force rebuild without Docker layer cache')
    }

    environment {
        DOPPLER_TOKEN   = credentials('doppler-personal-token')
        DOPPLER_PROJECT = 'sec-pipeline'
        DOPPLER_CONFIG  = 'prd'
        SSH_CREDS_ID    = 'windows-laptop-ssh'
        IMAGE_NAME      = 'fund-rabbitmq:latest'
        CONTAINER_NAME  = 'fund-orchestration-rabbitmq'
    }

    stages {
        stage('Fetch Secrets from Doppler Cloud') {
            steps {
                script {
                    echo "Fetching secrets from Doppler..."
                    def dopplerResponse = sh(
                        script: "curl -s --request GET --url 'https://api.doppler.com/v3/configs/config/secrets/download?project=${DOPPLER_PROJECT}&config=${DOPPLER_CONFIG}&format=json' --header 'accept: application/json' --header \"authorization: Bearer ${env.DOPPLER_TOKEN}\"",
                        returnStdout: true
                    ).trim()

                    def secrets = readJSON text: dopplerResponse

                    env.WINDOWS_HOST  = secrets.WINDOWS_HOST
                    env.WINDOWS_USER  = secrets.WINDOWS_USER
                    env.RABBITMQ_USER = secrets.RABBITMQ_DEFAULT_USER
                    env.RABBITMQ_PASS = secrets.RABBITMQ_DEFAULT_PASS

                    echo "Successfully loaded secrets for host: ${env.WINDOWS_HOST}"
                }
            }
        }

        stage('Pre-flight: Validate Definitions JSON') {
            steps {
                script {
                    readJSON file: 'config/rabbitmq/definitions.json'
                    echo "definitions.json syntax validated."
                }
            }
        }

        stage('Build Baked RabbitMQ Image on Windows Host') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                    script {
                        def noCache = params.FORCE_DOCKER_NO_CACHE ? "--no-cache" : ""
                        sh """
                            tar -czf - Dockerfile config | ssh -i "\$SSH_KEY" \
                                -o StrictHostKeyChecking=no \
                                -o ConnectTimeout=15 \
                                ${WINDOWS_USER}@${WINDOWS_HOST} \
                                "docker build ${noCache} -t ${IMAGE_NAME} -"
                        """
                    }
                }
            }
        }

        stage('Deploy RabbitMQ Container') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                    script {
                        def resetVolumeCmd = params.RESET_BROKER_DATA ? "docker volume rm rabbitmq_data ;" : ""

                            sh """
                                ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no ${WINDOWS_USER}@${WINDOWS_HOST} "
                                    docker rm -f ${CONTAINER_NAME} ;
                                    ${resetVolumeCmd}
                                    docker run -d \
                                        --name ${CONTAINER_NAME} \
                                        --hostname rabbitmq-broker \
                                        --restart unless-stopped \
                                        -p 5672:5672 \
                                        -p 15672:15672 \
                                        -v rabbitmq_data:/var/lib/rabbitmq \
                                        -e RABBITMQ_DEFAULT_USER='${env.RABBITMQ_USER}' \
                                        -e RABBITMQ_DEFAULT_PASS='${env.RABBITMQ_PASS}' \
                                        ${IMAGE_NAME}
                                "
                            """
                        }
                    }
                }
            }

        stage('Verify Broker Healthcheck') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                    echo "Waiting for RabbitMQ healthcheck ping..."
                    sh """
                        # Allow retry loop commands to fail without terminating the shell immediately
                        set +e

                        for attempt in \$(seq 1 20); do
                            echo "Healthcheck attempt \${attempt}/20..."

                            ssh -i "\$SSH_KEY" \
                                -o StrictHostKeyChecking=no \
                                -o ConnectTimeout=15 \
                                ${WINDOWS_USER}@${WINDOWS_HOST} \
                                "docker exec -u rabbitmq ${CONTAINER_NAME} rabbitmq-diagnostics -q ping" > /dev/null 2>&1

                            STATUS=\$?
                            if [ \$STATUS -eq 0 ]; then
                                echo "RabbitMQ is HEALTHY"
                                exit 0
                            fi

                            echo "Broker not ready yet. Retrying in 4s..."
                            sleep 4
                        done

                        echo "================ CONTAINER LOG DUMP ================"
                        ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no ${WINDOWS_USER}@${WINDOWS_HOST} "docker logs --tail 40 ${CONTAINER_NAME}"
                        echo "==================================================="
                        echo "ERROR: RabbitMQ ping timed out after 80s"
                        exit 1
                    """
                }
            }
        }

        stage('Provision RabbitMQ Admin User') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDS_ID, keyFileVariable: 'SSH_KEY')]) {
                    echo "Ensuring Doppler admin user is provisioned..."
                    sh """
                        ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no ${WINDOWS_USER}@${WINDOWS_HOST} "
                            docker exec ${CONTAINER_NAME} rabbitmqctl add_user '${env.RABBITMQ_USER}' '${env.RABBITMQ_PASS}' ;
                            docker exec ${CONTAINER_NAME} rabbitmqctl change_password '${env.RABBITMQ_USER}' '${env.RABBITMQ_PASS}' ;
                            docker exec ${CONTAINER_NAME} rabbitmqctl set_user_tags '${env.RABBITMQ_USER}' administrator ;
                            docker exec ${CONTAINER_NAME} rabbitmqctl set_permissions -p / '${env.RABBITMQ_USER}' '.*' '.*' '.*'
                        "
                    """
                    }
                }
            }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Custom RabbitMQ image built and container launched successfully."
        }
        failure {
            echo "RabbitMQ deployment failed. Inspect logs above."
        }
    }
}